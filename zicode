#!/usr/bin/env zsh
# zicode — Zenith AI Coding Harness launcher
# Usage:
#   zicode                          → runs on current dir with issue.txt
#   zicode /path/to/repo            → custom repo, default issue.txt
#   zicode /path/to/repo my.txt     → custom repo + issue file
#   zicode --dry                    → dry-run (no API calls, no cost)
#   zicode --verbose                → verbose output with token stream
#   zicode -h                       → show help

ZENITH_HOME="/Users/vamsikrishna/Dev Projects/i proj/Zenith"
PYTHON="/opt/anaconda3/bin/python3"

# ── Help ────────────────────────────────────────────────────────────────────
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  echo ""
  echo "  ╔══════════════════════════════════════╗"
  echo "  ║   zicode — Zenith Harness Launcher   ║"
  echo "  ╚══════════════════════════════════════╝"
  echo ""
  echo "  Usage:"
  echo "    zicode                          Run on current dir with issue.txt"
  echo "    zicode /path/to/repo            Custom repo, uses ./issue.txt"
  echo "    zicode /path/to/repo issue.txt  Custom repo and issue file"
  echo "    zicode --dry                    Dry-run (no API calls)"
  echo "    zicode --verbose                Show live token/cost stream"
  echo "    zicode -h                       This help message"
  echo ""
  echo "  Output: .harness/report.md, .harness/telemetry.jsonl"
  echo ""
  exit 0
fi

# ── Parse args ───────────────────────────────────────────────────────────────
REPO_PATH="."
ISSUE_PATH="issue.txt"
EXTRA_FLAGS=("--verbose")
POSITIONAL=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry)
      EXTRA_FLAGS+=("--dry-run")
      shift
      ;;
    --verbose)
      shift
      ;;
    --quiet)
      EXTRA_FLAGS=("${(@)EXTRA_FLAGS:#--verbose}")
      EXTRA_FLAGS+=("--quiet")
      shift
      ;;
    --max-steps|--model|--temperature|--token-budget|--agent-mode|--output-dir|--config)
      EXTRA_FLAGS+=("$1" "$2")
      shift 2
      ;;
    --max-steps=*|--model=*|--temperature=*|--token-budget=*|--agent-mode=*|--output-dir=*|--config=*)
      EXTRA_FLAGS+=("$1")
      shift
      ;;
    --*)
      EXTRA_FLAGS+=("$1")
      shift
      ;;
    *)
      if [[ $POSITIONAL -eq 0 ]]; then
        REPO_PATH="$1"
        POSITIONAL=1
      elif [[ $POSITIONAL -eq 1 ]]; then
        ISSUE_PATH="$1"
        POSITIONAL=2
      else
        EXTRA_FLAGS+=("$1")
      fi
      shift
      ;;
  esac
done

# ── Load .env secrets ────────────────────────────────────────────────────────
if [[ -f "$ZENITH_HOME/.env" ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^#.*$ || -z "$line" ]] && continue
    export "$line"
  done < "$ZENITH_HOME/.env"
fi

KEY_COUNT=$(grep -c -E '^AI_API_KEY(_[0-9]+)?=' "$ZENITH_HOME/.env" 2>/dev/null || echo "1")

# ── Run ──────────────────────────────────────────────────────────────────────
echo ""
echo "  ⚡ zicode → Zenith AI Engine"
echo "  Model : gemini-3.5-flash-lite (cascade: 3.5-flash → 3.6-flash)"
echo "  Pool  : $KEY_COUNT active keys (~$(( KEY_COUNT * 15 )) RPM capacity)"
echo "  Repo  : $REPO_PATH"
echo "  Issue : $ISSUE_PATH"
[[ ${#EXTRA_FLAGS[@]} -gt 0 ]] && echo "  Flags : ${EXTRA_FLAGS[*]}"
echo ""

cd "$ZENITH_HOME" && "$PYTHON" -m harness.cli \
  --repo "$REPO_PATH" \
  --issue "$ISSUE_PATH" \
  "${EXTRA_FLAGS[@]}"
