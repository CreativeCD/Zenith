# Zenith Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Required: Primary AI Provider API key (Google Gemini / Anthropic / OpenAI)
AI_API_KEY=your_api_key_here

# Optional: Additional API keys for Multi-Key Rotation Pool (~15 RPM per key)
# Add multiple Google AI Studio keys to unlock high throughput and resilience against 429 errors
AI_API_KEY_1=
AI_API_KEY_2=
AI_API_KEY_3=
AI_API_KEY_4=
AI_API_KEY_5=
AI_API_KEY_6=
AI_API_KEY_7=

# Optional: GitHub personal access token (increases search and skill API rate limits)
GITHUB_TOKEN=your_github_token_here

# Optional: Override default model endpoint
# AI_BASE_URL=https://api.example.com/v1

# Optional: Log level (DEBUG | INFO | WARNING | ERROR)
# LOG_LEVEL=INFO
