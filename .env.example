# Zenith Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ==============================================================================
# AI Provider API Keys (Automatic Multi-Provider Discovery & Key Rotation)
# ==============================================================================
# Zenith automatically discovers whichever keys exist in the environment:
# - If DeepSeek keys are set, Zenith uses DeepSeek.
# - If Gemini keys are set, Zenith uses Gemini.
# - If OpenAI keys are set, Zenith uses OpenAI.
# - If multiple keys exist for any provider, all keys are pooled and rotated with
#   round-robin to maximize rate limits and avoid 429 throttling!

# ── DeepSeek API Keys ─────────────────────────────────────────────────────────
# Get keys at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek Multi-Key Rotation Pool (Use 1, 3, 8 or more keys to multiply RPM):
# Numbered variables (DEEPSEEK_API_KEY_1..N) or comma-separated in DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY_1=
# DEEPSEEK_API_KEY_2=
# DEEPSEEK_API_KEY_3=
# DEEPSEEK_API_KEY_4=
# DEEPSEEK_API_KEY_5=
# DEEPSEEK_API_KEY_6=
# DEEPSEEK_API_KEY_7=
# DEEPSEEK_API_KEY_8=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Google Gemini API Keys ───────────────────────────────────────────────────
# Get free keys at: https://aistudio.google.com/
# AI_API_KEY=your_gemini_api_key_here
# AI_API_KEY_1=
# AI_API_KEY_2=
# AI_API_KEY_3=
# AI_API_KEY_4=

# ── OpenAI / Compatible Keys ──────────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Optional Integrations
# ==============================================================================
# GitHub personal access token (increases search and skill API rate limits)
GITHUB_TOKEN=your_github_token_here

# Optional: Log level (DEBUG | INFO | WARNING | ERROR)
# LOG_LEVEL=INFO
